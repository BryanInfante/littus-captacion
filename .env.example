# Plantilla de variables de entorno. Copiala a .env y completá los valores.
# .env y .env.* están en .gitignore; solo este .env.example se commitea.
# Nunca pegues un valor real acá.
#
# Este archivo es para trabajo LOCAL. En producción estas credenciales viven
# como Edge Function Secrets en Supabase:
#     supabase secrets set RESEND_API_KEY=... --project-ref <ref>
#
# Ninguna debe terminar en public/. Las páginas públicas solo usan la
# publishable key, que va en public/app.js y public/certificados.js.


# --- Supabase ---------------------------------------------------------------

# Tras el wipe del 2026-07-25, usá el ref del proyecto NUEVO.
# No qfbhyzynpyqqcpuuibod.
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co

# Service role key: salta RLS por completo, tratala como contraseña de admin.
# Empieza con sb_secret_ o eyJ... Si empieza con sb_publishable_ es la equivocada.
SUPABASE_SERVICE_ROLE_KEY=

# Variante que las Edge Functions leen primero. Para el script de recuperación
# alcanza con la de arriba.
# SUPABASE_SECRET_KEYS={"default":"sb_secret_..."}


# --- Nextcloud (WebDAV) -----------------------------------------------------

# Donde viven los PDFs de los certificados. Sobrevivieron al wipe y son la
# fuente para reconstruir las filas perdidas.
# URL a la raíz WebDAV del usuario, SIN barra final. El script le agrega
# masterclass-ultrasonido-nivel-i/2026/
NEXTCLOUD_WEBDAV_URL=https://tu-nextcloud.example.com/remote.php/dav/files/USUARIO
NEXTCLOUD_USERNAME=

# App password, NO la contraseña de la cuenta.
# Configuración > Seguridad > Dispositivos y sesiones. Revocable sin tocar la real.
NEXTCLOUD_APP_PASSWORD=


# --- URLs públicas ----------------------------------------------------------

# Origen para armar las URLs de validación del QR. Sin barra final.
CERTIFICATE_PUBLIC_BASE_URL=https://preinscripcion.littusgroup.com


# --- Resend -----------------------------------------------------------------

# Solo si corrés Edge Functions localmente. El script de recuperación no
# manda correos.
# Operativos: POST /emails. Promocionales: SIEMPRE Broadcasts API con
# segment_id, nunca /emails. Ver EMAIL_OPERATIONS.md.
RESEND_API_KEY=